<?xml version="1.0"?>
<!-- Minimal FreeSWITCH config for the bike call center (internal test).
     Only the modules this project needs are loaded, so a missing stock
     config file can never break startup. Generated live config lives in
     conf-live/ (gitignored); this template is never edited in place. -->
<document type="freeswitch/xml">
  <section name="configuration" description="Configuration">
    <!-- SIP domain: the public IP softphones and (later) the 400 trunk
         register/call to. local_ip_v4 is auto-detected by the core. -->
    <X-PRE-PROCESS cmd="set" data="domain=36.139.118.227"/>
    <configuration name="modules.conf" description="Modules">
      <modules>
        <load module="mod_console"/>
        <load module="mod_logfile"/>
        <load module="mod_event_socket"/>
        <load module="mod_commands"/>
        <load module="mod_dptools"/>
        <load module="mod_dialplan_xml"/>
        <load module="mod_sofia"/>
        <load module="mod_loopback"/>
        <load module="mod_callcenter"/>
        <load module="mod_json_cdr"/>
        <load module="mod_lua"/>
        <load module="mod_curl"/>
        <load module="mod_native_file"/>
        <load module="mod_sndfile"/>
        <load module="mod_tone_stream"/>
      </modules>
    </configuration>
    <X-PRE-PROCESS cmd="include" data="switch.conf.xml"/>
    <X-PRE-PROCESS cmd="include" data="acl.conf.xml"/>
    <X-PRE-PROCESS cmd="include" data="sofia.conf.xml"/>
    <X-PRE-PROCESS cmd="include" data="callcenter.conf.xml"/>
    <X-PRE-PROCESS cmd="include" data="json_cdr.conf.xml"/>
    <X-PRE-PROCESS cmd="include" data="event_socket.conf.xml"/>
  </section>
  <section name="dialplan" description="Dialplan">
    <X-PRE-PROCESS cmd="include" data="dialplan/*.xml"/>
  </section>
  <section name="directory" description="Directory">
    <X-PRE-PROCESS cmd="include" data="directory/*.xml"/>
  </section>
</document>
