# Copy to .env on the server only. NEVER commit the real .env to Git.
ZAMMAD_URL=http://host.docker.internal:8899
ZAMMAD_TOKEN=replace-with-zammad-api-token
ZAMMAD_CTI_TOKEN=replace-with-zammad-cti-token
BRIDGE_SECRET=replace-with-a-long-random-string
RECORDING_DIR=/recordings
BRIDGE_DB=/data/bridge.db
# Optional: user id filed as customer on phone tickets. Leave empty to
# auto-resolve the first admin user (no customer accounts are created).
# TICKET_CUSTOMER_ID=
# Seat logins in roster order for voicemail dispatch (fewest-calls) and
# for the board's per-seat stats/history. Keep these equal to the agent
# Zammad logins, and use the seat numbers as logins (8001/8002/8003)
# so queue CDRs (cc_agent) line up with the roster.
ROTATION_AGENTS=8001,8002,8003
# Event-socket password: normally read from the server-side
# freeswitch/esl-password.txt (mounted read-only); set here only to
# override it. ESL_HOST/ESL_PORT default to host.docker.internal:8021.
# ESL_PASSWORD=
