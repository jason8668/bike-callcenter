# Copy to .env on the server only. NEVER commit the real .env to Git.
BRIDGE_SECRET=replace-with-a-long-random-string
RECORDING_DIR=/recordings
BRIDGE_DB=/data/bridge.db
# Seat numbers in roster order for voicemail dispatch (fewest-calls) and
# for the board's per-seat stats/history. These are the FreeSWITCH
# extensions, so queue CDRs (cc_agent) line up with the roster.
ROTATION_AGENTS=8001,8002,8003
# Event-socket password: normally read from the server-side
# freeswitch/esl-password.txt (mounted read-only); set here only to
# override it. ESL_HOST/ESL_PORT default to host.docker.internal:8021.
# ESL_PASSWORD=
